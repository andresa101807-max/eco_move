          "request": {"method": "POST", "url": {"raw": "{{baseUrl}}/api/users/:id/balance/deduct?amount=5", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id", "balance", "deduct"], "query": [{"key": "amount", "value": "5"}], "variable": [{"key": "id", "value": "<user-id>"}]}}
