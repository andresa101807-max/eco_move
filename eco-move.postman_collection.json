        {"name": "Get maintenance by ID", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/maintenances/{{maintenanceId}}", "host": ["{{baseUrl}}"], "path": ["api", "maintenances", "{{maintenanceId}}"]}}},
        {"name": "Create maintenance", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', ()=> pm.response.to.have.status(201));","pm.environment.set('maintenanceId', pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"description\": \"Cambio de frenos\",\n  \"scheduledDate\": \"2025-11-20T10:00:00\"\n}"}, "url": {"raw": "{{baseUrl}}/api/maintenances", "host": ["{{baseUrl}}"], "path": ["api", "maintenances"]}}},
