          "request": {"method": "POST", "url": {"raw": "{{baseUrl}}/api/users/:id/balance/add?amount=20", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id", "balance", "add"], "query": [{"key": "amount", "value": "20"}], "variable": [{"key": "id", "value": "<user-id>"}]}}
        },
