{
  "info": {
    "_postman_id": "a6f8f3b0-2f9c-4e4b-9d4a-eco-move-collection",
    "name": "Eco Move API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for Eco Move API endpoints. Use the {{baseUrl}} variable to point to your server."
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Healthcheck",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Get all vehicles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
            }
          }
        },
        {
          "name": "Get vehicle by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "{{vehicleId}}"]
            }
          }
        },
        {
          "name": "Create vehicle (Electric Bike example)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set('vehicleId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"City Bike\",\n  \"model\": \"CB-100\",\n  \"brand\": \"EcoBrand\",\n  \"type\": \"ELECTRIC_BIKE\",\n  \"status\": \"AVAILABLE\",\n  \"pricePerHour\": 5.0,\n  \"currentLocation\": { \"latitude\": 5.0703, \"longitude\": -75.5138 },\n  \"battery\": { \"capacity\": 500, \"currentCharge\": 500, \"chargeCycles\": 0, \"maxChargeCycles\": 1000 },\n  \"gears\": 6,\n  \"hasLights\": true,\n  \"weight\": 18.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
            }
          }
        },
        {
          "name": "Update vehicle",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"City Bike Pro\",\n  \"model\": \"CB-200\",\n  \"brand\": \"EcoBrand\",\n  \"type\": \"ELECTRIC_BIKE\",\n  \"status\": \"AVAILABLE\",\n  \"pricePerHour\": 6.0,\n  \"currentLocation\": { \"latitude\": 5.0703, \"longitude\": -75.5138 },\n  \"battery\": { \"capacity\": 500, \"currentCharge\": 400, \"chargeCycles\": 10, \"maxChargeCycles\": 1000 },\n  \"gears\": 7,\n  \"hasLights\": true,\n  \"weight\": 18.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "{{vehicleId}}"]
            }
          }
        },
        {
          "name": "Delete vehicle",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "{{vehicleId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"]}}
        },
        {
          "name": "Get user by ID",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"]}}
        },
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set('userId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Perez\",\n  \"email\": \"juan@example.com\",\n  \"phoneNumber\": \"3001234567\",\n  \"dateOfBirth\": \"1995-05-10\",\n  \"documentNumber\": \"12345678\",\n  \"userType\": \"REGULAR\",\n  \"balance\": 0,\n  \"active\": true,\n  \"tripHistory\": \"\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"]}
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Juan Actualizado\",\n  \"email\": \"juan@example.com\",\n  \"phoneNumber\": \"3001234567\",\n  \"dateOfBirth\": \"1995-05-10\",\n  \"documentNumber\": \"12345678\",\n  \"userType\": \"PREMIUM\",\n  \"balance\": 10,\n  \"active\": true,\n  \"tripHistory\": \"\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"]}
          }
        },
        {
          "name": "Delete user",
          "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"]}}
        }
      ]
    },
    {
      "name": "Routes",
      "item": [
        {"name": "Get all routes", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/routes", "host": ["{{baseUrl}}"], "path": ["api", "routes"]}}},
        {"name": "Get route by ID", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/routes/{{routeId}}", "host": ["{{baseUrl}}"], "path": ["api", "routes", "{{routeId}}"]}}},
        {"name": "Create route", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', ()=> pm.response.to.have.status(201));","pm.environment.set('routeId', pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Campus Loop\",\n  \"description\": \"Ruta corta por el campus\",\n  \"startPoint\": { \"latitude\": 5.0700, \"longitude\": -75.5140 },\n  \"endPoint\": { \"latitude\": 5.0720, \"longitude\": -75.5120 },\n  \"difficulty\": \"easy\",\n  \"waypoints\": []\n}"}, "url": {"raw": "{{baseUrl}}/api/routes", "host": ["{{baseUrl}}"], "path": ["api", "routes"]}}},
        {"name": "Update route", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Campus Loop Ext\",\n  \"description\": \"Ruta extendida\",\n  \"startPoint\": { \"latitude\": 5.0700, \"longitude\": -75.5140 },\n  \"endPoint\": { \"latitude\": 5.0740, \"longitude\": -75.5100 },\n  \"difficulty\": \"medium\",\n  \"waypoints\": []\n}"}, "url": {"raw": "{{baseUrl}}/api/routes/{{routeId}}", "host": ["{{baseUrl}}"], "path": ["api", "routes", "{{routeId}}"]}}},
        {"name": "Delete route", "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/api/routes/{{routeId}}", "host": ["{{baseUrl}}"], "path": ["api", "routes", "{{routeId}}"]}}}
      ]
    }
  ],
