            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Juan Actualizado\",\n  \"email\": \"juan@example.com\",\n  \"phoneNumber\": \"3001234567\",\n  \"dateOfBirth\": \"1995-05-10\",\n  \"documentNumber\": \"12345678\",\n  \"userType\": \"PREMIUM\",\n  \"balance\": 10,\n  \"active\": true,\n  \"tripHistory\": \"\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"]}
          }
        },
        {
          "name": "Delete user",
          "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"]}}
        },
        {
          "name": "Add balance",
          "request": {"method": "POST", "url": {"raw": "{{baseUrl}}/api/users/{{userId}}/balance/add?amount=20", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "balance", "add"], "query": [{"key": "amount", "value": "20"}]}}
        },
