{
  "info": {
    "_postman_id": "2d7b7ce3-6a2e-4f67-9c9a-eco-move-quick-tests",
    "name": "Eco Move API - Quick Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Minimal collection to quickly test core flows. Use with eco-move.postman_environment.json."
  },
  "item": [
    {
      "name": "Users - Create & Get",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set('userId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"phoneNumber\": \"3000000000\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"documentNumber\": \"DOC123\",\n  \"userType\": \"REGULAR\",\n  \"balance\": 0,\n  \"active\": true,\n  \"tripHistory\": \"\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api","users"]}
          }
        },
        {
          "name": "Get user by id",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}"]}}
        }
      ]
    },
    {
      "name": "Vehicles - Create Bike & Get",
      "item": [
        {
          "name": "Create electric bike",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set('vehicleId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quick Bike\",\n  \"model\": \"QB-1\",\n  \"brand\": \"Eco\",\n  \"type\": \"ELECTRIC_BIKE\",\n  \"status\": \"AVAILABLE\",\n  \"pricePerHour\": 4.5,\n  \"currentLocation\": { \"latitude\": 5.07, \"longitude\": -75.51 },\n  \"battery\": { \"capacity\": 500, \"currentCharge\": 500, \"chargeCycles\": 0, \"maxChargeCycles\": 1000 },\n  \"gears\": 6,\n  \"hasLights\": true,\n  \"weight\": 18.0\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/vehicles", "host": ["{{baseUrl}}"], "path": ["api","vehicles"]}
          }
        },
        {
          "name": "Get vehicle by id",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}", "host": ["{{baseUrl}}"], "path": ["api","vehicles","{{vehicleId}}"]}}
        }
      ]
    },
    {
      "name": "Routes - Create & Get",
      "item": [
        {
          "name": "Create route",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set('routeId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quick Route\",\n  \"description\": \"Ruta de prueba\",\n  \"startPoint\": { \"latitude\": 5.0700, \"longitude\": -75.5140 },\n  \"endPoint\": { \"latitude\": 5.0720, \"longitude\": -75.5120 },\n  \"difficulty\": \"easy\",\n  \"waypoints\": []\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/routes", "host": ["{{baseUrl}}"], "path": ["api","routes"]}
          }
        },
        {
          "name": "Get route by id",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/routes/{{routeId}}", "host": ["{{baseUrl}}"], "path": ["api","routes","{{routeId}}"]}}
        }
      ]
    },
    {
      "name": "Reservations - Create & Complete",
      "item": [
        {
          "name": "Create reservation (uses userId & vehicleId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set('reservationId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"startTime\": \"2025-11-20T09:00:00\",\n  \"endTime\": \"2025-11-20T10:00:00\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api","reservations"]}
          }
        },
        {
          "name": "Complete reservation (sets vehicle available)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/complete?cost=9.0",
              "host": ["{{baseUrl}}"],
              "path": ["api","reservations","{{reservationId}}","complete"],
              "query": [{"key": "cost", "value": "9.0"}]
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup (optional)",
      "item": [
        {"name": "Delete reservation", "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/api/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["api","reservations","{{reservationId}}"]}}},
        {"name": "Delete vehicle", "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}", "host": ["{{baseUrl}}"], "path": ["api","vehicles","{{vehicleId}}"]}}},
        {"name": "Delete user", "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}"]}}},
        {"name": "Delete route", "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/api/routes/{{routeId}}", "host": ["{{baseUrl}}"], "path": ["api","routes","{{routeId}}"]}}}
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080", "type": "string"}
  ]
}
